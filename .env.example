# Environment Configuration Example
# Copy to .env and fill in real values. Keep .env out of Git.

# App
APP_NAME="PUP e-IPMO"
APP_URL="http://localhost/capstone"
ENVIRONMENT=development
DEBUG_MODE=true

# Database
DB_HOST=localhost
DB_NAME=ipmo_users
DB_USERNAME=root
DB_PASSWORD=
DB_PORT=3306

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD="your_app_password_here"
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=your_email@example.com
SMTP_FROM_NAME="PUP e-IPMO"

# Sessions & Security
SESSION_IDLE_TIMEOUT=1800
ADMIN_SESSION_IDLE_TIMEOUT=300
SESSION_LIFETIME=28800
AUDIT_LOG_FILE="${APP_URL}/audit.log"
CSRF_SECRET=
SESSION_ENCRYPT_KEY=

# Storage (optional override)
# STORAGE_PATH=C:\\ipmo_storage
