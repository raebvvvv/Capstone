# Environment Configuration Template
# Copy this file to .env and update values for your environment

# Database Configuration
DB_HOST=localhost
DB_NAME=ipmo_users
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="IPMO System"

# Security Configuration
SESSION_LIFETIME=28800
AUDIT_LOG_ENABLED=true
ENVIRONMENT=development

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,doc,docx,jpg,jpeg,png

# Application Configuration
APP_NAME="IPMO - Intellectual Property Management Office"
APP_URL=http://localhost/Capstone
ADMIN_EMAIL=admin@yourschool.edu

# Security Keys (generate with: openssl rand -hex 32)
CSRF_SECRET=your_32_character_csrf_secret_key_here
SESSION_ENCRYPT_KEY=your_32_character_session_encrypt_key

# Development/Production Settings
DEBUG_MODE=true
ERROR_REPORTING=true
LOG_ERRORS=true